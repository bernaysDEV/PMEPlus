# ============================================================
# PME — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── DATABASE (Supabase) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:6543/postgres?pgbouncer=true

# ── SERVER ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SESSION_SECRET=generate_with_openssl_rand_hex_32
INSTANCE_NAMESPACE=pme

# ── URLS ────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
BASE_URL=https://your-backend.railway.app
ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# ── REDIS (Railway adds this automatically) ─────────────────
REDIS_URL=redis://...

# ── AI PROVIDERS ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# ── EMAIL ───────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com

# ── GOOGLE OAUTH ────────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── APPLE OAUTH (optional) ──────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── STORAGE ─────────────────────────────────────────────────
# Option A: Cloudflare R2 (recommended)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Option B: AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION=
# AWS_S3_IMAGES_BUCKET=

# ── PUSH NOTIFICATIONS (optional) ───────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── TWILIO SMS (optional) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SID=

# ── WORKERS/JOBS ────────────────────────────────────────────
ENABLE_BACKGROUND_WORKERS=true
ENABLE_NEWSLETTER_SCHEDULER=true
ENABLE_AI_TASKS_SCHEDULER=true
